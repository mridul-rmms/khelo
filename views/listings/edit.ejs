<% layout("layouts/boilerplate") %>

<div class="mb-4">
    <a href="/listings/<%= listing._id %>" class="btn-back">&larr; Cancel & Back</a>
</div>

<div class="form-container">
    <h2 class="h4 mb-1">Edit Venue</h2>
    <p class="text-muted small mb-4">Update details for <%= listing.title %></p>

    <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate>
        <div class="form-group">
            <label for="title" class="form-label">Venue Title</label>
            <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" class="form-control" required>
            <div class="invalid-feedback">Please enter a venue title</div>
        </div>

        <div class="form-group">
            <label for="sports" class="form-label">Sport Category</label>
            <select id="sports" name="listing[sports]" class="form-select" required>
                <option value="Cricket/Football" <%= listing.sports === 'Cricket/Football' ? 'selected' : '' %>>Cricket / Football</option>
                <option value="Basketball" <%= listing.sports === 'Basketball' ? 'selected' : '' %>>Basketball</option>
                <option value="Badminton" <%= listing.sports === 'Badminton' ? 'selected' : '' %>>Badminton</option>
                <option value="Volleyball" <%= listing.sports === 'Volleyball' ? 'selected' : '' %>>Volleyball</option>
                <option value="Swimming" <%= listing.sports === 'Swimming' ? 'selected' : '' %>>Swimming</option>
                <option value="Indoor Sports" <%= listing.sports === 'Indoor Sports' ? 'selected' : '' %>>Indoor Sports</option>
            </select>
            <div class="invalid-feedback">Please select a sport category</div>
        </div>

        <div class="form-group">
            <label for="image" class="form-label">Image URL</label>
            <input type="url" id="image" name="listing[image]" value="<%= listing.image %>" class="form-control">
            <div class="invalid-feedback">Please enter a valid image URL</div>
        </div>

        <div class="row g-3">
            <div class="col-md-6 form-group">
                <label for="price" class="form-label">Price per Hour (&#8377;)</label>
                <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" min="0" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid price</div>
            </div>

            <div class="col-md-6 form-group">
                <label for="phone" class="form-label">Phone Number</label>
                <input type="tel" id="phone" name="listing[phone]" value="<%= listing.phone %>" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid phone number</div>
            </div>
        </div>

        <div class="form-group">
            <label for="email" class="form-label">Contact Email</label>
            <input type="email" id="email" name="listing[email]" value="<%= listing.email %>" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid contact email</div>
        </div>

        <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="listing[description]" rows="4" class="form-control" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <button type="submit" class="btn-submit">
            Save Changes
        </button>
    </form>
</div>