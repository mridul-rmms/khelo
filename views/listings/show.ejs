<% layout("layouts/boilerplate") %>

<div class="show-wrapper">
    <div class="mb-4">
        <a href="/listings" class="btn-back">&larr; Back to Venues</a>
    </div>

    <div class="show-card">
        <div class="show-img-box">
            <img src="<%= listing.image || 'https://www.revturf.com/wp-content/uploads/2022/05/Turf-football-gound-IMG_5312-2-1536x1152.jpg' %>"
                alt="<%= listing.title %>"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1529900748604-07564a03e7a6?w=800&q=80';">
        </div>

        <div class="show-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <div class="small text-muted mb-1">
                        Owned By <i><%= listing.owner ? listing.owner.username : 'Host' %></i>
                    </div>
                    <h1 class="h2 mb-2">
                        <%= listing.title %>
                    </h1>
                    <% if (listing.sports) { %>
                        <span class="badge bg-secondary bg-opacity-25 text-light fw-normal">
                            <%= listing.sports %>
                        </span>
                    <% } %>
                </div>

                <div class="venue-price fs-3">
                    &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %>/hour
                </div>
            </div>

            <p class="text-light opacity-75 fs-6 mb-4" style="white-space: pre-line;">
                <%= listing.description || 'No description provided.' %>
            </p>

            <!-- Contact Info Display -->
            <div class="info-row">
                <div class="info-block">
                    <span>Phone</span>
                    <strong>+91 <%= listing.phone || 'N/A' %></strong>
                </div>

                <div class="info-block">
                    <span>Email</span>
                    <strong><%= listing.email || 'N/A' %></strong>
                </div>
            </div>

            <!-- Slot Booking -->
            <div class="slot-booking-container mb-4">
                <% if (currUser) { %>
                    <%
                    const slots = [
                        { value: "morning",   label: "8:00am - 11:00am (Morning)" },
                        { value: "afternoon", label: "1:00pm - 3:00pm (Afternoon)" },
                        { value: "evening",   label: "4:00pm - 7:00pm (Evening)" },
                        { value: "night",     label: "8:00pm - 12:00am (Night / Floodlights)" }
                    ];
                    const freeSlots = slots.filter(s => !bookedSlots.includes(s.value));
                    %>

                    <% if (!date) { %>
                        <!-- Calendar / Date picker form (visible before date selection) -->
                        <div class="date-picker-card p-3 rounded-3 mb-3">
                            <label for="booking-date" class="form-label fw-semibold small text-light mb-2">
                                <i class="fa-regular fa-calendar me-1 text-warning"></i> Select Playing Date
                            </label>
                            <form action="/listings/<%= listing._id %>" method="get" class="d-flex flex-wrap gap-2">
                                <input type="date" id="booking-date" name="date" value="<%= date %>"
                                    min="<%= minDate %>" max="<%= maxDate %>" class="form-control flex-grow-1 calendar-input" required>
                                <button type="submit" class="btn-minimal">Check Available Slots</button>
                            </form>
                        </div>
                    <% } else { %>
                        <!-- Once date is selected: hide calendar, show selected date and available slots -->
                        <div class="slots-container p-3 rounded-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <div class="text-light fw-semibold">
                                    <i class="fa-regular fa-calendar-check text-success me-1"></i> Slots for: <span class="text-warning"><%= date %></span>
                                </div>
                                <a href="/listings/<%= listing._id %>" class="btn-secondary-minimal py-1 px-2 small">
                                    Change Date
                                </a>
                            </div>

                            <% if (freeSlots.length === 0) { %>
                                <div class="alert alert-warning mb-0 text-dark" role="alert">
                                    All slots are booked for <%= date %>. Please pick another date.
                                </div>
                            <% } else { %>
                                <form action="/listings/<%= listing._id %>/booking" method="post">
                                    <input type="hidden" name="booking[date]" value="<%= date %>">
                                    <div class="mb-3">
                                        <label class="form-label small text-muted mb-2">Choose Available Slot:</label>
                                        <select name="booking[slot]" class="form-select mb-3" required>
                                            <% freeSlots.forEach(s => { %>
                                                <option value="<%= s.value %>"><%= s.label %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn-minimal w-100 py-2">Confirm & Book Slot</button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="p-3 border border-secondary border-opacity-25 rounded-3 text-center">
                        <span class="text-muted small">Please <a href="/login" class="text-success text-decoration-none fw-semibold">log in</a> to check and book playing slots.</span>
                    </div>
                <% } %>
            </div>

            <!-- Owner Action Buttons -->
            <div class="d-flex justify-content-end align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
                    <div class="d-flex gap-2">
                        <a href="/listings/<%= listing._id %>/edit" class="btn-secondary-minimal">Edit</a>
                        <a href="/listings/<%= listing._id %>/destroy"
                            onclick="return confirm('Delete this venue listing?')"
                            class="btn-secondary-minimal text-danger border-danger border-opacity-50">Delete</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="reviews-container mb-5">
        <h4 class="mb-4">Reviews & Ratings</h4>

        <% if (currUser) { %>
            <div class="review-form-card mb-4">
                <h5 class="review-form-title">Leave a Review</h5>
                <form method="post" action="/listings/<%= listing.id %>/reviews" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label mb-1">Rating</label>
                        <div class="star-rating-select">
                            <input type="radio" id="rate5" name="reviews[rating]" value="5" />
                            <label for="rate5" title="5 stars"><i class="fa-solid fa-star"></i></label>

                            <input type="radio" id="rate4" name="reviews[rating]" value="4" />
                            <label for="rate4" title="4 stars"><i class="fa-solid fa-star"></i></label>

                            <input type="radio" id="rate3" name="reviews[rating]" value="3" />
                            <label for="rate3" title="3 stars"><i class="fa-solid fa-star"></i></label>

                            <input type="radio" id="rate2" name="reviews[rating]" value="2" />
                            <label for="rate2" title="2 stars"><i class="fa-solid fa-star"></i></label>

                            <input type="radio" id="rate1" name="reviews[rating]" value="1" />
                            <label for="rate1" title="1 star"><i class="fa-solid fa-star"></i></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea id="comment" name="reviews[comment]" cols="30" rows="3" class="form-control"
                            placeholder="Share your experience..." required></textarea>
                        <div class="invalid-feedback">
                            Please add a comment
                        </div>
                    </div>
                    <button class="btn-minimal px-4">Submit</button>
                </form>
            </div>
        <% } %>

        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <div class="row g-3">
                <% for (item of listing.reviews) { %>
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="review-card h-100 p-3">
                            <div class="d-flex flex-column justify-content-between h-100">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="review-avatar">
                                            <%= item.author && item.author.username ?
                                                item.author.username.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                        <h6 class="fw-bold mb-0 text-light">
                                            @<%= item.author ? item.author.username : 'User' %>
                                        </h6>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 mb-2 text-warning">
                                        <% for (let s = 1; s <= 5; s++) { %>
                                            <% if (s <= item.rating) { %>
                                                <i class="fa-solid fa-star text-warning"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-star text-secondary"></i>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <p class="review-comment-text mb-2">
                                        <%= item.comment %>
                                    </p>
                                </div>
                                <% if (currUser && item.author && currUser._id.equals(item.author._id)) { %>
                                    <form class="mt-3 pt-2 border-top border-secondary border-opacity-25"
                                        method="post"
                                        action="/listings/<%= listing._id %>/reviews/<%= item._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <p class="text-muted">No reviews yet.</p>
        <% } %>
    </div>
</div>
